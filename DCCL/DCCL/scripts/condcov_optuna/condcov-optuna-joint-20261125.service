[Unit]
Description=CondCov joint Optuna queue for PACS, VLCS and OfficeHome
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/media/hooasia/data/condcov_optuna_joint_20261125/code/DCCL/DCCL
ExecStartPre=/usr/bin/mountpoint -q /media/hooasia/data
ExecStart=/home/hooasia/miniconda3/envs/dccl/bin/python -B -u scripts/condcov_optuna/run.py
Restart=on-failure
RestartSec=60
StandardOutput=append:/media/hooasia/data/condcov_optuna_joint_20261125/queue-console.log
StandardError=inherit

[Install]
WantedBy=default.target
